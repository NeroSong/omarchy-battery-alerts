#!/usr/bin/python3 -B
"""Transactionally add Battery Alerts to the user-owned menu extension."""

import os

from menu_file import (
    END,
    ENTRY_ID,
    START,
    marked_entry,
    menu_directory,
    parse_jsonc,
    read_menu,
    replace_menu,
    save_backup,
    strip_jsonc,
)
from safe_file import fail


ENTRY = (
    '  // battery-alerts:start\n'
    '  "setup.battery-alerts": {\n'
    '    "icon": "󱐋",\n'
    '    "label": "Battery Alerts",\n'
    '    "aliases": ["battery", "low battery"],\n'
    '    "description": "Configure low and critical battery thresholds",\n'
    '    "action": "/usr/bin/omarchy-shell shell summon nerosong.battery-alerts"\n'
    '  }\n'
    '  // battery-alerts:end\n'
)


directory = None
try:
    directory = menu_directory()
    raw = read_menu(directory)
    text = "{}\n" if raw is None else raw.decode("utf-8")
    parsed = parse_jsonc(text)
    if isinstance(parsed.get("items"), dict):
        fail(
            "menu uses an items wrapper; add the documented entry manually"
        )

    has_marker = START in text or END in text
    if has_marker:
        marked_entry(text)
        if ENTRY_ID not in parsed:
            fail("marked Battery Alerts entry is missing from the menu object")
        print("Battery Alerts menu entry already exists")
        raise SystemExit(0)
    if ENTRY_ID in parsed:
        print("Battery Alerts menu entry already exists")
        raise SystemExit(0)

    opening = text.find("{")
    closing = text.rfind("}")
    if opening < 0 or closing < opening:
        fail("menu has no top-level object")
    body = strip_jsonc(text[opening + 1 : closing]).strip()
    prefix = text[:closing].rstrip()
    separator = "" if not body or prefix.endswith(",") else ","
    updated = prefix + separator + "\n" + ENTRY + text[closing:]
    parse_jsonc(updated)

    if raw is not None:
        save_backup(directory, raw)
    replace_menu(directory, updated)
    print("Installed Battery Alerts menu entry")
except (OSError, ValueError, RuntimeError, UnicodeError) as error:
    raise SystemExit("battery-alerts menu update refused: " + str(error))
finally:
    if directory is not None:
        os.close(directory)
