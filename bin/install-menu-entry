#!/usr/bin/env python3
"""Add Battery Alerts to the user-owned Omarchy menu extension."""

from pathlib import Path
import json
import os
import re
import shutil
import stat
import tempfile


START = "// battery-alerts:start"
ENTRY_ID = "setup.battery-alerts"
ENTRY = (
    '  // battery-alerts:start\n'
    '  "setup.battery-alerts": {\n'
    '    "icon": "󱐋",\n'
    '    "label": "Battery Alerts",\n'
    '    "aliases": ["battery", "low battery"],\n'
    '    "description": "Configure low and critical battery thresholds",\n'
    '    "action": "omarchy-shell shell summon nerosong.battery-alerts"\n'
    '  }\n'
    '  // battery-alerts:end\n'
)


def without_comments(value: str) -> str:
    return re.sub(r"^\s*//[^\n]*(?:\n|$)", "", value, flags=re.MULTILINE)


def parse_jsonc(value: str) -> dict:
    stripped = without_comments(value)
    stripped = re.sub(r",(\s*[}\]])", r"\1", stripped)
    parsed = json.loads(stripped)
    if not isinstance(parsed, dict):
        raise ValueError("outer value must be an object")
    return parsed


def atomic_write_with_backup(path: Path, value: str) -> None:
    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else None
    if path.exists():
        shutil.copy2(path, path.with_name(path.name + ".battery-alerts.bak"))

    descriptor, temporary = tempfile.mkstemp(
        prefix=f".{path.name}.", dir=path.parent, text=True
    )
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(value)
            output.flush()
            os.fsync(output.fileno())
        if mode is not None:
            os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


path = Path.home() / ".config/omarchy/extensions/omarchy-menu.jsonc"
path.parent.mkdir(parents=True, exist_ok=True)
text = path.read_text(encoding="utf-8") if path.exists() else "{}\n"

try:
    parsed = parse_jsonc(text)
except (json.JSONDecodeError, ValueError) as error:
    raise SystemExit(f"Refusing to edit invalid menu file ({error}): {path}")

entry_pattern = re.compile(r'^\s*"' + re.escape(ENTRY_ID) + r'"\s*:', re.MULTILINE)
wrapped_items = parsed.get("items")
source = wrapped_items if isinstance(wrapped_items, dict) else parsed
if START in text or entry_pattern.search(text) or ENTRY_ID in source:
    print(f"Battery Alerts menu entry already exists in {path}")
    raise SystemExit(0)

if isinstance(wrapped_items, dict):
    raise SystemExit(
        f"Refusing to rewrite an items-wrapped menu; add the documented entry manually: {path}"
    )

closing = text.rfind("}")
if closing < 0:
    raise SystemExit(f"Refusing to edit invalid menu file (missing closing brace): {path}")

opening = text.find("{")
if opening < 0 or opening > closing:
    raise SystemExit(f"Refusing to edit invalid menu file (missing object): {path}")

body = without_comments(text[opening + 1 : closing]).strip()
prefix = text[:closing].rstrip()
separator = "" if not body or prefix.endswith(",") else ","
updated = prefix + separator + "\n" + ENTRY + text[closing:]
atomic_write_with_backup(path, updated)
print(f"Installed Battery Alerts menu entry in {path}")
