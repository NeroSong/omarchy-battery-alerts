#!/usr/bin/python3 -B
"""Transactionally remove only the marked Battery Alerts menu entry."""

import os
import re

from menu_file import (
    BLOCK_PATTERN,
    END,
    START,
    marked_entry,
    menu_directory,
    parse_jsonc,
    read_menu,
    replace_menu,
    save_backup,
)


directory = None
try:
    directory = menu_directory(create=False)
    raw = read_menu(directory)
    if raw is None:
        print("No Omarchy menu extension found")
        raise SystemExit(0)
    text = raw.decode("utf-8")
    if START not in text and END not in text:
        print("No Battery Alerts menu entry found")
        raise SystemExit(0)

    marked_entry(text)
    updated, count = BLOCK_PATTERN.subn("\n", text, count=1)
    if count != 1:
        raise RuntimeError("refusing malformed Battery Alerts menu block")
    updated = re.sub(r"({\s*),", r"\1", updated, count=1)
    updated = re.sub(r",(\s*})", r"\1", updated, count=1)
    parse_jsonc(updated)

    save_backup(directory, raw)
    replace_menu(directory, updated)
    print("Removed Battery Alerts menu entry")
except FileNotFoundError:
    print("No Omarchy menu extension found")
except (OSError, ValueError, RuntimeError, UnicodeError) as error:
    raise SystemExit("battery-alerts menu update refused: " + str(error))
finally:
    if directory is not None:
        os.close(directory)
