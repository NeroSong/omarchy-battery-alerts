#!/usr/bin/env python3
"""Remove only the Battery Alerts block from the Omarchy menu extension."""

from pathlib import Path
import re


path = Path.home() / ".config/omarchy/extensions/omarchy-menu.jsonc"
if not path.exists():
    print(f"No Omarchy menu extension found at {path}")
    raise SystemExit(0)

text = path.read_text()
pattern = re.compile(
    r",?\s*// battery-alerts:start\n.*?// battery-alerts:end\n?",
    flags=re.DOTALL,
)
updated, count = pattern.subn("\n", text, count=1)
if count == 0:
    print(f"No Battery Alerts menu entry found in {path}")
    raise SystemExit(0)

# Repair the two possible edges when the marked block was the first/last item.
updated = re.sub(r"({\s*),", r"\1", updated, count=1)
updated = re.sub(r",(\s*})", r"\1", updated, count=1)
path.write_text(updated)
print(f"Removed Battery Alerts menu entry from {path}")
