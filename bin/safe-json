#!/usr/bin/python3 -B
"""Bounded, no-follow persistence gateway for Battery Alerts QML."""

import json
import sys

from safe_file import atomic_replace, data_dir, fail, read_regular


if len(sys.argv) not in (3, 4) or sys.argv[1] not in ("read", "write") or sys.argv[2] not in ("settings", "state"):
    raise SystemExit("usage: safe-json read KIND | safe-json write KIND JSON")

operation, kind = sys.argv[1:3]
directory = None
try:
    directory, name = data_dir(kind)
    if operation == "read":
        value = read_regular(directory, name)
        if value is None:
            print("{}")
        else:
            parsed = json.loads(value.decode("utf-8"))
            if not isinstance(parsed, dict):
                fail("refusing a non-object JSON value")
            print(json.dumps(parsed, separators=(",", ":"), ensure_ascii=False))
    else:
        if len(sys.argv) != 4:
            raise SystemExit("safe-json write requires JSON")
        parsed = json.loads(sys.argv[3])
        if not isinstance(parsed, dict):
            fail("refusing a non-object JSON value")
        atomic_replace(directory, name, (json.dumps(parsed, indent=2, ensure_ascii=False) + "\n").encode())
except (OSError, ValueError, RuntimeError, UnicodeError) as error:
    raise SystemExit("battery-alerts persistence refused: " + str(error))
finally:
    if directory is not None:
        __import__("os").close(directory)
